{
  "manifest_version": 3,
  "name": "听风实时流",
  "version": "0.4.0",
  "description": "把听风实时预警直接路由到交易标的，减少切站和搜索时间。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["https://wind.jokkimon.club/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://wind.jokkimon.club/*"],
      "js": ["assets/windMainBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://wind.jokkimon.club/*"],
      "js": ["assets/windRelay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "打开听风实时流"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
